OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3.5-super-vl:free
CHAT_TEMPERATURE=0.1
CHAT_MAX_TOKENS=4096

AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AMAZON_BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024

# Corpus ingest: batch (default) | ondemand (legacy self-throttle path)
BEDROCK_INGEST_MODE=batch
AWS_S3_EMBEDDING_BUCKET=
AWS_S3_EMBEDDING_INPUT_PREFIX=bedrock/embeddings/input/
AWS_S3_EMBEDDING_OUTPUT_PREFIX=bedrock/embeddings/output/
BEDROCK_BATCH_ROLE_ARN=
BEDROCK_BATCH_JOB_NAME_PREFIX=hebbia-titan-embed
BEDROCK_BATCH_POLL_SECONDS=60
BEDROCK_BATCH_MIN_RECORDS=100

PINECONE_CLOUD=aws
PINECONE_API_KEY=
PINECONE_REGION=us-east-1
PINECONE_INDEX_NAME=hebbia-ai

CHUNK_SIZE_TOKENS=1000
CHUNK_OVERLAP_TOKENS=150
# Used only when BEDROCK_INGEST_MODE=ondemand
EMBEDDING_BATCH_SIZE=1
EMBEDDING_BATCH_PAUSE_SECONDS=2
MAX_CONSECUTIVE_RATE_LIMITS=10
RATE_LIMIT_MAX_BACKOFF_SECONDS=120
PINECONE_UPSERT_BATCH_SIZE=100

AGENT_MAX_ITERATIONS=6
RETRIEVAL_TOP_K=30
RERANK_TOP_N=7
CONTEXT_TOKEN_BUDGET=20000
MAX_QUERY_REWRITES=4
MAX_RETRIEVAL_CALLS=8
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

REQUEST_TIMEOUT_SECONDS=60
MAX_RETRIES=12
